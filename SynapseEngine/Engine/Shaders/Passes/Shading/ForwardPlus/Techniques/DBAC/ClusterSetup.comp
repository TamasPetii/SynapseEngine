#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "../../../../../Includes/Core.glsl"
#include "../../../../../Includes/Common/FrameGlobalContext.glsl"
#include "../../../../../Includes/Common/Camera.glsl"
#include "../../../../../Includes/Common/Cluster.glsl"
#include "../../../../../Includes/Utils/ClusterMath.glsl"

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

#include "../../../../../Includes/PushConstants/ClusterSetupPC.glsl"

layout(push_constant) uniform PushConstants {
    ClusterSetupPC pc;
};

shared float s_minZ;
shared float s_maxZ;
shared uint s_sliceCount;

void main() {
    FrameGlobalContext ctx = GET_FRAME_CONTEXT(pc.frameGlobalContextBufferAddr);

    uint threadId = gl_LocalInvocationID.x;
    ivec2 tileId = ivec2(gl_WorkGroupID.xy);
    uint flattenTileIdx = tileId.y * ctx.tileCountX + tileId.x;

    if (threadId == 0) {
        uint cameraIdx = GET_SPARSE_INDEX(ctx.cameraSparseMapBufferAddr, ctx.mainCameraEntity);
        CameraComponent camera = GET_CAMERA(ctx.cameraBufferAddr, cameraIdx);

        TileData precalcTile = GET_TILE_DATA(ctx.forwardPlusTileGridListBufferAddr, flattenTileIdx);
        
        s_minZ = precalcTile.minZ;
        s_maxZ = precalcTile.maxZ;
        
        if (s_minZ >= GET_CAMERA_FAR(camera) * 0.999) {
            s_sliceCount = 0;
        } else {
            s_sliceCount = CalculateClusterSliceCount(s_minZ, s_maxZ, ctx.sliceScaleFactor);
        }
    }

    barrier();

    uint needsWrite = (threadId < s_sliceCount) ? 1 : 0;
    uint subgroupWriteCount = subgroupAdd(needsWrite);
    uint localOffset = subgroupExclusiveAdd(needsWrite);
    uint baseOffset = 0;

    if (subgroupElect() && subgroupWriteCount > 0) {
        baseOffset = atomicAdd(GET_CLUSTER_COUNT(ctx.forwardPlusClusterCountBufferAddr), subgroupWriteCount);
    }

    baseOffset = subgroupBroadcastFirst(baseOffset);

    if (threadId == 0) {
        GET_TILE_DATA(ctx.forwardPlusTileGridListBufferAddr, flattenTileIdx).sliceCount = s_sliceCount;
        GET_TILE_DATA(ctx.forwardPlusTileGridListBufferAddr, flattenTileIdx).clusterBaseOffset = baseOffset;
    }

    if (needsWrite == 1) {
        float sliceMinZ, sliceMaxZ;

        if (s_sliceCount == 1) {
            sliceMinZ = s_minZ;
            sliceMaxZ = s_maxZ;
        } 
        else {
            float ratio = s_maxZ / s_minZ;
            sliceMinZ = s_minZ * pow(ratio, float(threadId) / float(s_sliceCount));
            sliceMaxZ = s_minZ * pow(ratio, float(threadId + 1) / float(s_sliceCount));
        }

        uint finalIndex = baseOffset + localOffset;

        ClusterData clusterData;
        clusterData.tileIndex = flattenTileIdx;
        clusterData.sliceIndex = threadId;
        clusterData.minZ = sliceMinZ;
        clusterData.maxZ = sliceMaxZ;
        clusterData.pointLightCount = 0;
        clusterData.pointLightOffset = 0;
        clusterData.spotLightCount = 0;
        clusterData.spotLightOffset = 0;

        GET_CLUSTER_DATA(ctx.forwardPlusClusterListBufferAddr, finalIndex) = clusterData;
    }
}