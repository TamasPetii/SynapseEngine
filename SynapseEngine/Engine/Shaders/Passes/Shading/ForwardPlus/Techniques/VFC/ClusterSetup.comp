#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../../../../../Includes/Core.glsl"
#include "../../../../../Includes/Common/FrameGlobalContext.glsl"
#include "../../../../../Includes/Common/Camera.glsl"
#include "../../../../../Includes/Common/Cluster.glsl"
#include "../../../../../Includes/Utils/ClusterMath.glsl"

#define CLUSTER_SLICE_COUNT 32

layout(local_size_x = CLUSTER_SLICE_COUNT, local_size_y = 1, local_size_z = 1) in;

#include "../../../../../Includes/PushConstants/ClusterSetupPC.glsl"

layout(push_constant) uniform PushConstants {
    ClusterSetupPC pc;
};

void main() {
    FrameGlobalContext ctx = GET_FRAME_CONTEXT(pc.frameGlobalContextBufferAddr);

    uint threadId = gl_LocalInvocationID.x;
    ivec2 tileId = ivec2(gl_WorkGroupID.xy);
    uint flattenTileIdx = tileId.y * ctx.tileCountX + tileId.x;

    uint cameraIdx = GET_SPARSE_INDEX(ctx.cameraSparseMapBufferAddr, ctx.mainCameraEntity);
    CameraComponent camera = GET_CAMERA(ctx.cameraBufferAddr, cameraIdx);
    
    float near = GET_CAMERA_NEAR(camera);
    float far  = GET_CAMERA_FAR(camera); 

    float ratio = far / near;
    float sliceMinZ = near * pow(ratio, float(threadId) / float(CLUSTER_SLICE_COUNT));
    float sliceMaxZ = near * pow(ratio, float(threadId + 1) / float(CLUSTER_SLICE_COUNT));

    uint baseOffset = flattenTileIdx * CLUSTER_SLICE_COUNT;

    if (threadId == 0) {
        TileData tileData;
        tileData.minZ = near;
        tileData.maxZ = far;
        tileData.sliceCount = CLUSTER_SLICE_COUNT;
        tileData.clusterBaseOffset = baseOffset;
        GET_TILE_DATA(ctx.forwardPlusTileGridListBufferAddr, flattenTileIdx) = tileData;

        atomicAdd(GET_CLUSTER_COUNT(ctx.forwardPlusClusterCountBufferAddr), CLUSTER_SLICE_COUNT);
    }

    uint finalIndex = baseOffset + threadId;

    ClusterData clusterData;
    clusterData.tileIndex = flattenTileIdx;
    clusterData.sliceIndex = threadId;
    clusterData.minZ = sliceMinZ;
    clusterData.maxZ = sliceMaxZ;
    clusterData.pointLightCount = 0;
    clusterData.pointLightOffset = 0;
    clusterData.spotLightCount = 0;
    clusterData.spotLightOffset = 0;

    GET_CLUSTER_DATA(ctx.forwardPlusClusterListBufferAddr, finalIndex) = clusterData;
}