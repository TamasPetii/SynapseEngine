#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "../../../../Includes/Core.glsl"
#include "../../../../Includes/Common/FrameGlobalContext.glsl"
#include "../../../../Includes/Common/Camera.glsl"
#include "../../../../Includes/Common/Cluster.glsl"
#include "../../../../Includes/Common/SpotLight.glsl"
#include "../../../../Includes/Common/IndirectCommand.glsl"
#include "../../../../Includes/Utils/CullingMath.glsl"
#include "../../../../Includes/Utils/ClusterMath.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#include "../../../../Includes/PushConstants/ClusterLightWritePC.glsl"

layout(push_constant) uniform PushConstants {
    ClusterLightWritePC pc;
};

shared uint s_localSpotLightCount;
shared vec3 s_clusterSphereCenter;
shared float s_clusterSphereRadius;

void main() {
    FrameGlobalContext ctx = GET_FRAME_CONTEXT(pc.frameGlobalContextBufferAddr);

    uint threadId = gl_LocalInvocationID.x;
    uint clusterIdx = gl_WorkGroupID.x;

    uint activeClusterCount = GET_CLUSTER_COUNT(ctx.forwardPlusClusterCountBufferAddr);
    if (clusterIdx >= activeClusterCount) return;

    uint cameraIdx = GET_SPARSE_INDEX(ctx.cameraSparseMapBufferAddr, ctx.mainCameraEntity);
    CameraComponent camera = GET_CAMERA(ctx.cameraBufferAddr, cameraIdx);

    ClusterData cluster = GET_CLUSTER_DATA(ctx.forwardPlusClusterListBufferAddr, clusterIdx);

    if (threadId == 0) {
        s_localSpotLightCount = 0;
        
        vec3 aabbMin, aabbMax;
        GetClusterViewSpaceAABB(
            cluster.tileIndex, ctx.tileCountX, ctx.tileSize, ctx.screenWidth, ctx.screenHeight, 
            cluster.minZ, cluster.maxZ, camera.projVulkanInv, 
            aabbMin, aabbMax
        );

        vec3 extents = (aabbMax - aabbMin) * 0.5;
        s_clusterSphereCenter = aabbMin + extents;
        s_clusterSphereRadius = length(extents);
    }
    
    barrier();

    uint totalLights = GET_VK_DRAW_CMD(ctx.spotLightIndirectCommandBufferAddr, 0).instanceCount;
    uint globalOffset = cluster.spotLightOffset;

    for (uint i = threadId; i < totalLights; i += gl_WorkGroupSize.x) {
        uint entityIdx = GET_VISIBLE_SPOT_LIGHT(ctx.spotLightVisibleIndexBufferAddr, i);
        uint denseIdx = GET_SPARSE_INDEX(ctx.spotLightSparseMapBufferAddr, entityIdx);
        SpotLightColliderGPU collider = GET_SPOT_LIGHT_COLLIDER(ctx.spotLightColliderBufferAddr, denseIdx);
        
        vec3 viewSpacePos = (camera.view * vec4(collider.worldPos, 1.0)).xyz;
        vec3 viewSpaceDir = normalize(mat3(camera.view) * collider.worldDir);

        bool isIntersecting = TestConeSphere(
            viewSpacePos, viewSpaceDir, 
            collider.range, collider.outerAngleCos, collider.outerAngleSin,
            s_clusterSphereCenter, s_clusterSphereRadius
        );
        
        uvec4 ballot = subgroupBallot(isIntersecting);
        uint activeCount = subgroupBallotBitCount(ballot);
        
        uint baseOffset = 0;

        if (subgroupElect() && activeCount > 0) {
            baseOffset = atomicAdd(s_localSpotLightCount, activeCount);
        }
        
        baseOffset = subgroupBroadcastFirst(baseOffset);

        uint isIntersectingInt = isIntersecting ? 1 : 0;
        uint threadOffset = subgroupExclusiveAdd(isIntersectingInt);

        if (isIntersecting) {
            uint finalIdx = globalOffset + baseOffset + threadOffset;
            GET_LIGHT_INDEX(ctx.forwardPlusSpotLightIndexListBufferAddr, finalIdx) = entityIdx;
        }
    }
}