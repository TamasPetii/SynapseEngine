#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_quad : require

#include "../../../Includes/Core.glsl"
#include "../../../Includes/Common/FrameGlobalContext.glsl"
#include "../../../Includes/Common/Camera.glsl"
#include "../../../Includes/Utils/DepthMath.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform sampler2D inHizPyramid;
layout(set = 2, binding = 1, r16f) uniform writeonly image2D outAoImage;

#include "../../../Includes/PushConstants/DpHvoPC.glsl"

layout(push_constant) uniform PushConstants {
   DpHvoPC pc;
};

float SpatialHash(vec2 p) {
    vec3 p3  = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

void main() {
    FrameGlobalContext ctx = GET_FRAME_CONTEXT(pc.frameGlobalContextBufferAddr);

    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(ctx.screenWidth) || pos.y >= int(ctx.screenHeight)) return;

    vec2 uv = (vec2(pos) + vec2(0.5)) / vec2(ctx.screenWidth, ctx.screenHeight);
    
    uint cameraIdx = GET_SPARSE_INDEX(ctx.cameraSparseMapBufferAddr, ctx.mainCameraEntity);
    CameraComponent camera = GET_CAMERA(ctx.cameraBufferAddr, cameraIdx);

    float baseDepthNorm = textureLod(inHizPyramid, uv, 0).x; 
    
    // Skip skybox/background
    if (baseDepthNorm >= 0.999) {
        imageStore(outAoImage, pos, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    vec3 viewPos = GetViewPosFromLinearZ(uv, baseDepthNorm, camera);
    vec2 offsetU = vec2(1.0 / float(ctx.screenWidth), 0.0);
    vec2 offsetV = vec2(0.0, 1.0 / float(ctx.screenHeight));
    
    // Reconstruct view-space normal from depth gradients
    vec3 viewPosRight = GetViewPosFromLinearZ(uv + offsetU, textureOffset(inHizPyramid, uv, ivec2(1, 0)).x, camera);
    vec3 viewPosDown  = GetViewPosFromLinearZ(uv + offsetV, textureOffset(inHizPyramid, uv, ivec2(0, 1)).x, camera);
    vec3 viewNormal   = normalize(cross(viewPosRight - viewPos, viewPos - viewPosDown));

    vec3 viewDir = normalize(-viewPos); 
    float nDotV = max(dot(viewNormal, viewDir), 0.0);
    float pixelZ = mix(camera.params.x, camera.params.y, baseDepthNorm);

    float distanceScale = clamp(pixelZ * 0.05, 1.0, 2.5);
    float adaptiveBias = pc.bias * mix(4.0, 1.0, nDotV) * distanceScale;

    // Vogel spiral parameters
    float occlusion = 0.0;
    const float GOLDEN_ANGLE = 2.39996323;
    float randomPhase = SpatialHash(vec2(pos)) * 6.2831853;

    float aspect = float(ctx.screenWidth) / float(ctx.screenHeight);
    float fovScale = abs(camera.projVulkan[1][1]);
    float projRadius = (pc.aoRadius * fovScale) / (max(pixelZ, 0.1) * 2.0);
    projRadius = min(projRadius, 0.1);

    float maxScreenDim = float(max(ctx.screenWidth, ctx.screenHeight));

    for (int i = 0; i < pc.sampleCount; i++) {
        // Area-proportional radius distribution
        float radiusT = sqrt((float(i) + 0.5) / float(pc.sampleCount));
        float currentRadius = radiusT * projRadius;
        float pixelOffset = currentRadius * maxScreenDim;

        // Dynamic Mip selection: closer samples use sharper mips
        float mipLevel = clamp(log2(max(pixelOffset, 1.0)) - 1.0, 0.0, 4.0);
        float angle = randomPhase + float(i) * GOLDEN_ANGLE;

        vec2 sampleOffset = vec2(cos(angle) / aspect, sin(angle)) * currentRadius;
        vec2 sampleUv = clamp(uv + sampleOffset, 0.0, 1.0);

        vec2 cellDepthNorm = textureLod(inHizPyramid, sampleUv, mipLevel).rg;
        
        float cellMaxZ = mix(camera.params.x, camera.params.y, cellDepthNorm.r);
        float cellMinZ = mix(camera.params.x, camera.params.y, cellDepthNorm.g);

        float cellAvgZ = (cellMaxZ + cellMinZ) * 0.5;
        float deltaZ = max(abs(cellMaxZ - cellMinZ), 0.01);

        float depthDiff = pixelZ - cellAvgZ;
        
        // Check if sample volume is in front of the pixel (within max distance)
        if (depthDiff > adaptiveBias && depthDiff < pc.maxOcclusionDistance) {
            float intersection = max(0.0, 1.0 - (abs(depthDiff) / deltaZ));
            
            vec3 samplePos = GetViewPosFromLinearZ(sampleUv, cellDepthNorm.x, camera);
            vec3 dirToSample = normalize(samplePos - viewPos);
            float nDotL = max(dot(viewNormal, dirToSample), 0.0);

            occlusion += intersection * nDotL;
        }
    }

    float finalAo = clamp(1.0 - (occlusion / float(pc.sampleCount)) * pc.aoIntensity, 0.0, 1.0);
    
    // Hardware-accelerated 2x2 spatial blur
    //float ao_horizontal = subgroupQuadSwapHorizontal(finalAo);
    //float ao_vertical   = subgroupQuadSwapVertical(finalAo);
    //float ao_diagonal   = subgroupQuadSwapDiagonal(finalAo);

    //float blurredAo = (finalAo + ao_horizontal + ao_vertical + ao_diagonal) * 0.25;
    
    imageStore(outAoImage, pos, vec4(finalAo, 0.0, 0.0, 0.0));
}