#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform sampler2D inImage; 
layout(set = 2, binding = 1, rg32f) uniform writeonly image2D outImage;

#include "../../Includes/PushConstants/HizDownSamplePC.glsl"

layout(push_constant) uniform PushConstants {
   HizDownSamplePC pc;
};

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(pc.outImageSize.x) || pos.y >= int(pc.outImageSize.y)) return;

    vec2 uv = (vec2(pos * 2) + vec2(1.0)) / pc.inImageSize;

    vec4 depthsX = textureGather(inImage, uv, 0);
    vec4 depthsY = textureGather(inImage, uv, 1);

    float maxDepth = max(max(depthsX.x, depthsX.y), max(depthsX.z, depthsX.w));
    float minDepth = min(min(depthsY.x, depthsY.y), min(depthsY.z, depthsY.w));

    bool isOddX = (int(pc.inImageSize.x) % 2) != 0;
    bool isOddY = (int(pc.inImageSize.y) % 2) != 0;
    bool isLastColumn = (pos.x == int(pc.outImageSize.x) - 1);
    bool isLastRow = (pos.y == int(pc.outImageSize.y) - 1);

    ivec2 basePos = pos * 2;

    // Last column
    if (isOddX && isLastColumn) {
        vec2 e0 = texelFetch(inImage, basePos + ivec2(2, 0), 0).xy;
        vec2 e1 = texelFetch(inImage, basePos + ivec2(2, 1), 0).xy;
        maxDepth = max(maxDepth, max(e0.x, e1.x));
        minDepth = min(minDepth, min(e0.y, e1.y));
    }

    // Last row
    if (isOddY && isLastRow) {
        vec2 e2 = texelFetch(inImage, basePos + ivec2(0, 2), 0).xy;
        vec2 e3 = texelFetch(inImage, basePos + ivec2(1, 2), 0).xy;
        maxDepth = max(maxDepth, max(e2.x, e3.x));
        minDepth = min(minDepth, min(e2.y, e3.y));
    }

    // Last column/row corner
    if (isOddX && isOddY && isLastColumn && isLastRow) {
        vec2 e4 = texelFetch(inImage, basePos + ivec2(2, 2), 0).xy;
        maxDepth = max(maxDepth, e4.x);
        minDepth = min(minDepth, e4.y);
    }

    imageStore(outImage, pos, vec4(maxDepth, minDepth, 0.0, 0.0));
}