#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0) uniform sampler2D planeY;
layout(set = 2, binding = 1) uniform sampler2D planeUV;
layout(set = 2, binding = 2, rgba8) uniform writeonly image2D outputImage;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if(coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);

    float y = texture(planeY, uv).r;
    vec2 chroma = texture(planeUV, uv).rg - vec2(0.5);
    
    vec3 rgb;
    rgb.r = y + 1.5748 * chroma.y;
    rgb.g = y - 0.1873 * chroma.x - 0.4681 * chroma.y;
    rgb.b = y + 1.8556 * chroma.x;

    imageStore(outputImage, coord, vec4(rgb, 1.0));
}